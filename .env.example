# ---- Copy to .env and fill in. NEVER commit real values. ----
# Core
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
DB_URL=jdbc:postgresql://localhost:5432/vendocas
DB_USER=vendocas
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
# 32+ byte secrets, base64. Generate: openssl rand -base64 48
JWT_SECRET=
# AES-256 key for provider credentials at rest, base64 of 32 bytes: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Stripe (billing) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Amazon SES (email)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
PLATFORM_EMAIL_DOMAIN=
# SNS topic ARN subscribed to SES events (used to validate inbound notifications)
SES_SNS_TOPIC_ARN=

# Meta WhatsApp Cloud API (Embedded Signup)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Twilio (SMS / MMS / Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Brazil NFS-e provider (Focus NFe)
FOCUS_NFE_TOKEN=
FOCUS_NFE_ENVIRONMENT=homologacao

# S3-compatible storage (R2 / S3 / MinIO)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
