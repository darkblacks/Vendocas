{
  "name": "vendocas",
  "private": true,
  "description": "Vendocas — multi-tenant SaaS for sales recovery, relationship and communication automations.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:web": "pnpm --filter @vendocas/web dev",
    "build:web": "pnpm --filter @vendocas/web build",
    "test:web": "pnpm --filter @vendocas/web test",
    "e2e": "pnpm --filter @vendocas/web e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "api:test": "cd apps/api && mvn -B verify",
    "api:run": "cd apps/api && mvn spring-boot:run",
    "openapi:generate": "pnpm --filter @vendocas/api-client generate",
    "build:sdk": "pnpm --filter @vendocas/tracking-sdk build"
  }
}
